# Hostel Management System - Environment Configuration Example

# Flask Configuration
FLASK_APP=backend/run.py
FLASK_ENV=development
SECRET_KEY=enterprise_super_secret_hostel_key_2026_xyz
JWT_SECRET_KEY=jwt_super_secure_enterprise_key_2026_abc
PORT=5000

# Database Configuration (Strictly SQLite)
DATABASE_URL=sqlite:///instance/hostel.db

# File Upload Configuration
MAX_CONTENT_LENGTH=16777216
UPLOAD_FOLDER=backend/uploads

# Email / SMTP Configuration (Optional - falls back to test simulator if unconfigured)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=notifications@hosteldomain.com
MAIL_PASSWORD=your_app_password_here
MAIL_DEFAULT_SENDER="Hostel Admin <notifications@hosteldomain.com>"

# Frontend Configuration (Vite)
VITE_API_BASE_URL=http://localhost:5000/api
